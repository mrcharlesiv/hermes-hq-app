<Window
    x:Class="HermesHQ.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hermes HQ">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/HermesHQ-256.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Hermes HQ" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <Frame x:Name="Root" Grid.Row="1" />
        <!-- A sheet over the window (Add Gateway…, Manage Gateways…, a sign-in before a switch): the Mac's sheets. -->
        <Grid x:Name="SheetLayer" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Border x:Name="SheetCard" MaxWidth="560" MaxHeight="760" Margin="24,56,24,24" HorizontalAlignment="Center"
                    VerticalAlignment="Center" CornerRadius="10" BorderThickness="1"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
                <ContentControl IsTabStop="False" x:Name="SheetHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>
        </Grid>
    </Grid>
</Window>
