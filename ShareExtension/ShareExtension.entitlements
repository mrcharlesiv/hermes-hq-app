<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group holds the bot roster the app caches for the sheet and the "open this chat" note a share leaves
	     (ShareKit/ShareStore.swift, docs/spec/3x-share.md §5.1). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.charlesmcdowell.dispatch</string>
	</array>
	<!-- The app's own default Keychain access group (its application identifier), where AccountVault keeps the signed-in
	     accounts' sessions. Listing it here lets the extension read that item and write a renewed session back; the
	     app's item never moves and the app's own entitlements don't change, so an update signs nobody out. Team
	     provisioning profiles allow every TEAMID.* access group: this needs no portal capability. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HQ_APP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
