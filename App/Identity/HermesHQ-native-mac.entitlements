<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- [mac] The Mac app (Mac Catalyst) of HQ Native's record: as HermesHQ-native.entitlements, inside the App Sandbox the
     Mac App Store asks for. Gateways and the Nous loopback catch (LoopbackRelay) need the network both ways; photos,
     voice and Talk need the camera and microphone; attachments come from files the owner picks. -->
<dict>
	<!-- The app's own Keychain group, which is its default one on iOS. The Mac reaches the data protection Keychain only
	     with it (else every saved sign-in fails with errSecMissingEntitlement). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- [device-access] Settings › Device Access: the sandbox doors for Contacts, Location, and Calendar and Reminders. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
