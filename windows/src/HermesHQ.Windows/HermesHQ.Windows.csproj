<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hermes HQ for Windows: WinUI 3 on the Windows App SDK. Builds on Windows only (Visual Studio 2022 with the
       "Windows application development" workload, or the .NET 9 SDK plus the Windows SDK):
         dotnet build windows/src/HermesHQ.Windows -p:Platform=x64
       M1 ships unpackaged and self-contained (a folder with HermesHQ.exe): no MSIX signing to sideload. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>HermesHQ</RootNamespace>
    <AssemblyName>HermesHQ</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HermesHQ.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- An unpackaged app still needs its resources.pri (XAML resources); without this it crashes at launch. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <Product>Hermes HQ</Product>
    <Version>0.1.3</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <PackageReference Include="Markdig" Version="0.45.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hermes.Core\Hermes.Core.csproj" />
    <!-- [WIN-MATH-UI] The chat's formulas, typeset (CSharpMath in Latin Modern Math, drawn by SkiaSharp). -->
    <ProjectReference Include="..\Hermes.Math\Hermes.Math.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- [WIN-SCREEN-SETUP-SEND] The Mac screen installer "Set Up with Hermes" attaches (the reviewed bytes of the Mac's
         App/Resources/Screen/HermesHQScreenSetup.zip; ScreenSetupBundle refuses anything else). Opaque data: never run here. -->
    <Content Include="Screen\HermesHQScreenSetup.zip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
