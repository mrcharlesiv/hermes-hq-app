<Project Sdk="Microsoft.NET.Sdk">
  <!-- Link the production page, window and column. Their input, dispatcher, preferences and OS colours are inert. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <SettingsSource Condition="'$(SettingsSource)' == ''">../../src/HermesHQ.Windows/Features/Settings</SettingsSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SettingsSource)/SettingsPage.cs;$(SettingsSource)/SettingsWindow.cs;$(SettingsSource)/SettingsWindowColumn.cs" />
    <ProjectReference Include="../../src/Hermes.Core/Hermes.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
