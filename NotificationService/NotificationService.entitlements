<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's own default Keychain access group, where it keeps the seal keys and bot faces (Shared/PushSeal.swift,
	     PushFaces.swift): the extension only reads them. Team profiles allow every TEAMID.* group, so this needs no
	     portal capability (the web app's NotificationService.entitlements, build 240). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HQ_APP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
