<Page
    x:Class="HermesHQ.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <FontIcon x:Name="Glyph" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <TextBlock x:Name="TitleText" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock x:Name="NoteText" Text="Not on Windows yet. It's on the list in windows/PARITY.md." HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="DetailText" Visibility="Collapsed" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                   IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </StackPanel>
</Page>
