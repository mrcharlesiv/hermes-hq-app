<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- [mac] The notification extension in the Mac app (Mac Catalyst): NotificationService.entitlements plus the sandbox
     every Mac extension must have. It opens sealed alerts and reads bot faces; it makes no network calls. -->
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(HQ_APP_BUNDLE_ID)</string>
	</array>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
