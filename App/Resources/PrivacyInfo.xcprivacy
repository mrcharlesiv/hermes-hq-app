<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hermes HQ talks to the user's own Hermes gateway: no tracking, no third-party analytics, and no data collected
	     by the developer. Link titles, hosted images and connector logos are read from public hosts without cookies
	     (HermesKit/Net/LinkPreviewFetcher.swift, RemoteImageFetch.swift). Diagnostic logs go to the user's gateway only. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- The app's own preferences (CA92.1), and the Haptics switch it shares with its Share extension through the
		     App Group (1C8F.1, App/Kit/Haptics.swift). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<!-- ProcessInfo.systemUptime measures elapsed times on the device (startup, key repeat, push timing). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!-- Modification and creation dates and sizes of the app's own files in its container: caches, voice memos,
		     staged attachments, bot photos and diagnostic logs, to trim the oldest. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
